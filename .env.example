# Local machine paths. Copy to .env and fill in; .env is not committed.

# The DOS toolchain tree: the directory holding msc51/ and masm51/, as a Linux
# path (under WSL, /mnt/c/... for a directory on a Windows drive). MSC 5.1 and
# MASM 5.1 are proprietary, so the tree lives outside the repository;
# scripts/setup/layout_toolchain.py builds it from the extracted distribution
# disks.
DOS_TOOLCHAIN_DIR=
